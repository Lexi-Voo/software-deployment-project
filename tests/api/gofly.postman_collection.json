    {
      "name": "GET City Info",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "\r",
              "pm.test(\"Response contains all required city fields\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.have.property('name');\r",
              "    pm.expect(jsonData).to.have.property('extract');\r",
              "    pm.expect(jsonData).to.have.property('lat');\r",
              "    pm.expect(jsonData).to.have.property('lng');\r",
              "});\r",
              "\r",
              "pm.test(\"Coordinates are valid numbers\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.lat).to.be.a('number');\r",
              "    pm.expect(jsonData.lng).to.be.a('number');\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/city?name=Kuala Lumpur",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "api",
            "city"
          ],
          "query": [
            {
              "key": "name",
              "value": "Kuala Lumpur"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "GET Attraction List",
